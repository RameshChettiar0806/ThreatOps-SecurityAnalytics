# Environment Variables for ThreatOps

# =================================================================
# DATABASE CONFIGURATION
# =================================================================

# LOCAL DEVELOPMENT (PostgreSQL) - Default
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/threatops

# VERCEL DEPLOYMENT (Supabase PostgreSQL) - Production
# Use the Supabase pooler connection string for serverless deployments.
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Alternative: Railway PostgreSQL
# DATABASE_URL=postgresql://postgres:password@containers-us-west-123.railway.app:5432/railway

# Alternative: Render PostgreSQL
# DATABASE_URL=postgresql://user:password@dpg-xxxxx.oregon-postgres.render.com/dbname

# =================================================================
# FLASK CONFIGURATION
# =================================================================

# Flask Secret Key (REQUIRED - Change this to a random string in production)
SECRET_KEY=your-super-secret-key-change-this-in-production

# Generate a secure secret key with:
# python -c "import secrets; print(secrets.token_hex(32))"

# =================================================================
# DEPLOYMENT FLAGS (Optional - Auto-set by platforms)
# =================================================================

# Vercel (automatically set by Vercel, don't set locally)
# VERCEL=1

# Railway (automatically set by Railway)
# RAILWAY_ENVIRONMENT=production
