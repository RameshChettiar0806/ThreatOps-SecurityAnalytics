# Environment Variables for ThreatOps

# Database Connection String
# For local development:
DATABASE_URL=mysql+mysqlconnector://root:password@localhost:3306/threatops

# For Vercel deployment with PlanetScale (Recommended):
# DATABASE_URL=mysql://username:password@aws.connect.psdb.cloud/threatops?ssl={"ssl_disabled": false}

# For Vercel deployment with Railway:
# DATABASE_URL=mysql+mysqlconnector://root:password@containers-us-west-123.railway.app:7654/threatops

# Flask Secret Key (Change this to a random string in production)
SECRET_KEY=your-super-secret-key-change-this-in-production

# Optional: Vercel flag (automatically set by Vercel, don't set locally)
# VERCEL=1
